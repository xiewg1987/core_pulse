{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "启动开发服务器",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run dev",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "调试服务端 (Next.js)",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "next",
        "dev",
        "--hostname",
        "0.0.0.0",
        "--port",
        "47821"
      ],
      "windows": {
        "runtimeExecutable": "npx.cmd"
      },
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"],
      "serverReadyAction": {
        "pattern": "- Local:.+(https?://.+)",
        "uriFormat": "%s",
        "action": "debugWithChrome",
        "killOnServerStop": true
      }
    },
    {
      "name": "调试前端 (Chrome)",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:47821",
      "webRoot": "${workspaceFolder}"
    },
    {
      "name": "调试前端 (Edge)",
      "type": "msedge",
      "request": "launch",
      "url": "http://localhost:47821",
      "webRoot": "${workspaceFolder}"
    },
    {
      "name": "构建并启动生产",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run build && npm run start",
      "cwd": "${workspaceFolder}"
    }
  ]
}
